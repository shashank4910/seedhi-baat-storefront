{
  "name": "seedhi-baat-ebook-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply seedhi-baat-store --local",
    "db:migrate:remote": "wrangler d1 migrations apply seedhi-baat-store --remote",
    "upload:ebooks": "node scripts/upload-ebooks.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "typescript": "7.0.2",
    "wrangler": "4.131.0"
  }
}
